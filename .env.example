# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# JWT_SECRET: Secret key for signing JWT tokens (min 32 characters recommended)
JWT_SECRET="MY_JWT_SECRET"

# PRISMA_DATABASE_URL: PostgreSQL connection string for Prisma
PRISMA_DATABASE_URL="postgres://user:password@host:5432/dbname?sslmode=require"
